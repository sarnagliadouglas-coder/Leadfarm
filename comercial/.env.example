# Copie para .env e ajuste se necessário. NUNCA versione o .env real.
# O COMERCIAL não tem chaves nem segredos — este arquivo só configura ONDE o
# EQC (contrato + diretórios de pipeline) é encontrado em disco.
#
# --- Localização do EQC (camada transversal do LeadFarm) --------------------
# `ferramentas/eqc.py` NÃO guarda caminho absoluto de máquina. A raiz do EQC
# (".../EQC") é resolvida a cada execução, nesta ordem:
#
#   1. COMERCIAL_CONTRACT_SCHEMA  (caminho final do schema — vence tudo, no
#                                  ponto do schema)
#   2. COMERCIAL_EQC_ROOT         (pasta ".../EQC" direta)
#   3. LEADFARM_ROOT              (raiz do ecossistema; o EQC é <LEADFARM_ROOT>/EQC)
#   4. descoberta automática      (sobe a árvore do projeto até achar
#                                  "EQC/contracts/leads_qualificados.schema.json")
#   5. fallback "<pasta-que-contém-o-COMERCIAL>/EQC"
#   6. se o arquivo resolvido não existir, o loader falha com uma mensagem que
#      mostra a raiz tentada e quais variáveis definir.
#
# Normalmente NENHUMA variável precisa ser definida: a descoberta cobre o layout
# atual (EQC como pasta irmã, um nível acima) e o futuro
# Desktop\Projetos\LeadFarm\{EQC, EXTRATOR, QUALIFICADOR, COMERCIAL}.

# Raiz do ecossistema LeadFarm (a pasta que contém EQC/, EXTRATOR/, QUALIFICADOR/,
# COMERCIAL/). Se definida, o EQC é <LEADFARM_ROOT>/EQC.
LEADFARM_ROOT=

# Aponta direto para a pasta ".../EQC" (vence LEADFARM_ROOT). Útil se o EQC não
# for irmão do COMERCIAL.
COMERCIAL_EQC_ROOT=

# --- Overrides de CAMINHO FINAL (vencem a resolução da raiz, cada um no seu ponto) ---
# Se vazios/ausentes, derivam da raiz do EQC resolvida acima.

# Caminho do JSON Schema do contrato QUALIFICADOR -> COMERCIAL.
#   Default: <eqc_root>/contracts/leads_qualificados.schema.json
COMERCIAL_CONTRACT_SCHEMA=

# Diretório onde o QUALIFICADOR grava os lotes leads_qualificados_*.json.
#   Default: <eqc_root>/pipeline/qualificador-output
COMERCIAL_INPUT_DIR=

# --- Chamada à API da Anthropic (Etapa E1, ferramentas/llm_cliente.py) ------
# Decisão do diretor: produção pela API da Anthropic, chave própria dele.
# NUNCA versione o valor real. Sem esta variável, llm_config.resolver_api_key()
# falha com uma mensagem que diz exatamente o que fazer — nenhuma chamada é
# feita sem chave.
ANTHROPIC_API_KEY=

# Modelo usado na chamada (ferramentas/llm_config.py, resolver_modelo()).
# Vazio ⇒ usa "modelo_default" de config/precos_llm.json. Definido aqui,
# vence o default do arquivo de configuração.
COMERCIAL_LLM_MODEL=

# Pasta da planilha de envio em uso (pendencias_registro.py sem argumento
# usa a planilha_envio_*.xlsx mais recente daqui). Vazio => comercial/_planilhas/.
COMERCIAL_PLANILHAS_DIR=
